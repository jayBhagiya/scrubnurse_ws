<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scrubnurse_dashboard</name>
  <version>0.1.0</version>
  <description>Scrubnurse dashboard: web page to watch the cell (status, arm, camera with detections, voice), to pause, resume, abort and request tools, and to calibrate the camera.</description>
  <maintainer email="jabh00002@stud.uni-saarland.de">Jay Bhagiya</maintainer>
  <license>TODO</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>scrubnurse_interfaces</exec_depend>
  <exec_depend>scrubnurse_perception</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <!-- pip-only (installed into the workspace venv, see requirements.txt):
       opencv-python, fastapi, uvicorn, websockets -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
