<?xml version="1.0"?>
<!--
  Overhead camera of the simulated cell, spawned by sim.launch.py (camera:=true).
  Looks straight down like the real one - image right = base -y, image down = base -x,
  about 0.6 mm per pixel on the table. The pose is in the Gazebo world frame; in the UR
  base frame it is (0.016, -1.0, 0.671), see scrubnurse_sim/cell.py (OverheadCamera).
-->
<sdf version="1.8">
  <model name="overhead_camera">
    <static>true</static>
    <pose>-0.016 1.0 0.671 0 1.5707963 3.14159265</pose>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <link name="link">
      <visual name="visual"><geometry><box><size>0.03 0.10 0.03</size></box></geometry></visual>
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.5707963</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>5.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>overhead_camera/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
