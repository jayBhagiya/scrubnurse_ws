<?xml version="1.0"?>
<!--
  Scrubnurse cell for Gazebo Fortress. GENERATED by scripts/generate_world.py from
  scrubnurse_bringup/config/poses.yaml; edit the script, not this file.

  Everything is placed in the frame "ur_base", the UR `base` frame of poses.yaml (ROS 2
  base_link / Gazebo world rotated 180 deg about z). Holders sit where the recorded poses put
  a held tool - an upright magazine (A..F), the surgeon's hand at the handover pose P (visual
  only), an upright return rack (RA..RF) and the work table. Tools are 9 cm stand-ins (shaft plus handle towards +x).
  The overhead camera is a separate model (models/overhead_camera.sdf), spawned by
  sim.launch.py with camera:=true once the controllers are up.
-->
<sdf version="1.8">
  <world name="scrubnurse_cell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <frame name="ur_base">
      <pose>0 0 0 0 0 3.14159265</pose>
    </frame>

    <model name="cell">
      <static>true</static>
      <pose relative_to="ur_base">0 0 0 0 0 0</pose>
      <link name="link">
{links}      </link>
    </model>

{tools}  </world>
</sdf>
