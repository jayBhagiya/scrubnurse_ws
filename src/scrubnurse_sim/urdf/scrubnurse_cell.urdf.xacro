<?xml version="1.0"?>
<!--
  Scrubnurse robot for Gazebo Fortress - UR10e from ur_description plus a simplified
  Hand-E-like parallel gripper. Loaded by ur_simulation_gz's ur_sim_control.launch.py
  (description_package:=scrubnurse_sim); the static cell and the tools are in
  worlds/scrubnurse_cell.sdf.

  Keep colon-space out of these comments - ur_sim_control.launch.py (0.5.0) passes this
  description through a YAML parser.

  Gripper - body 0.10 m and fingers 0.05 m along tool0 z, fingers closing along tool0 x,
  stroke 2 x 25 mm (finger joint 0 = open, 0.025 = closed). The fingers are visual only;
  grasping uses one DetachableJoint per tool, attached and detached by the sim_gripper node.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="sim_ignition" default="true"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="initial_positions_file"
             default="$(find scrubnurse_sim)/config/initial_positions.yaml"/>
  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>
  <xacro:property name="tools" value="${['tool_A', 'tool_B', 'tool_C', 'tool_D', 'tool_E', 'tool_F', 'tool_C_table']}"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    ur_type="$(arg ur_type)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    sim_ignition="$(arg sim_ignition)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Gripper -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y * y + z * z) / 12}" ixy="0" ixz="0"
               iyy="${mass * (x * x + z * z) / 12}" iyz="0" izz="${mass * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>

  <link name="gripper_body">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.08 0.06 0.10"/></geometry>
      <material name="gripper_grey"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.08 0.06 0.10"/></geometry>
    </collision>
    <xacro:box_inertia mass="0.8" x="0.08" y="0.06" z="0.10"/>
  </link>
  <joint name="gripper_mount" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_body"/>
  </joint>

  <xacro:macro name="finger" params="side sign">
    <link name="finger_${side}">
      <visual>
        <origin xyz="0 0 0.025"/>
        <geometry><box size="0.012 0.022 0.05"/></geometry>
        <material name="finger_black"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <xacro:box_inertia mass="0.05" x="0.012" y="0.022" z="0.05"/>
    </link>
    <joint name="finger_${side}_joint" type="prismatic">
      <parent link="gripper_body"/>
      <child link="finger_${side}"/>
      <origin xyz="${sign * 0.031} 0 0.10"/>
      <axis xyz="${-sign} 0 0"/>
      <limit lower="0.0" upper="0.025" effort="100" velocity="0.15"/>
    </joint>
  </xacro:macro>
  <xacro:finger side="left" sign="-1"/>
  <xacro:finger side="right" sign="1"/>

  <!-- Reference frame between the fingertips, where a grasped tool's centre sits. -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_tcp"/>
    <origin xyz="0 0 0.146"/>
  </joint>

  <ros2_control name="sim_gripper" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <xacro:macro name="finger_interfaces" params="side">
      <joint name="finger_${side}_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:finger_interfaces side="left"/>
    <xacro:finger_interfaces side="right"/>
  </ros2_control>

  <!-- One detachable joint per tool; URDF fixed joints are merged, so the gripper body
       ends up in wrist_3_link. -->
  <xacro:macro name="tool_holder" params="tools">
    <xacro:if value="${tools}">
      <gazebo>
        <plugin filename="ignition-gazebo-detachable-joint-system"
                name="ignition::gazebo::systems::DetachableJoint">
          <parent_link>wrist_3_link</parent_link>
          <child_model>${tools[0]}</child_model>
          <child_link>link</child_link>
          <attach_topic>/scrubnurse_sim/${tools[0]}/attach</attach_topic>
          <detach_topic>/scrubnurse_sim/${tools[0]}/detach</detach_topic>
        </plugin>
      </gazebo>
      <xacro:tool_holder tools="${tools[1:]}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:tool_holder tools="${tools}"/>

  <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <controller_manager_node_name>$(arg tf_prefix)controller_manager</controller_manager_node_name>
    </plugin>
  </gazebo>
</robot>
