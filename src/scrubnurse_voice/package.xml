<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scrubnurse_voice</name>
  <version>0.1.0</version>
  <description>Scrubnurse voice commands: Whisper speech recognition mapped to surgical tool ids.</description>
  <maintainer email="jabh00002@stud.uni-saarland.de">Jay Bhagiya</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>portaudio19-dev</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <!-- pip-only (installed into the workspace venv, see requirements.txt):
       torch, openai-whisper, sounddevice, soundfile (pip build reads mp3) -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
